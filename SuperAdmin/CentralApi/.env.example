# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/central_api?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="1d"
CREDENTIAL_ENCRYPTION_KEY="generate-32-bytes-hex-with-node-crypto"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Server
PORT=4000
NODE_ENV="development"

# SMTP (자체 메일 서버 — SPF/DKIM/DMARC DNS 설정 필��)
SMTP_HOST=mail.mealticket.vn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@mealticket.vn
SMTP_PASS=
SMTP_FROM="Meal Ticket Platform <noreply@mealticket.vn>"

# CORS
ALLOWED_ORIGINS="http://localhost:3000"
