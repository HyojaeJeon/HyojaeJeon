// ─────────────────────────────────────────────
// MealTicket Domain (B2B 모바일 식권 플랫폼)
// 한국어: 기준서 §99 MealTicket 도메인 편입 결정에 따른 DB 원본.
//   - Corporate (신규 계층, 식권 고객 기업)
//   - MealCorporateDepartment / MealEmployee / MealWallet
//   - MealPolicy / MealFundingAccount
//   - MealWalletFundingEntry (allowance ledger / top-up audit)
//   - MealMerchantEnrollment / MealMerchantCommissionRate / MealMerchantSettlementAccount (BrandHQ 에 attach)
//   - MealTransaction / MealSettlementBatch / MealConsolidatedEInvoice
// 모든 테이블은 `Meal*` 네임스페이스. 컬럼은 camelCase. (CLAUDE.md 규칙)
// Tiếng Việt: Nguồn DB cho domain MealTicket.
// ─────────────────────────────────────────────

enum MealWalletFundingSourceType {
  COMPANY_ALLOWANCE
  PERSONAL_TOP_UP
}

enum MealWalletFundingStatus {
  PENDING
  POSTED
  REVERSED
}

// 한국어: Corporate 테이블 — 식권 고객 기업.
//   기준서 §2.1 신규 계층. BrandHQ 의 형제 계층이며 Branch 를 소유하지 않는다.
// Tiếng Việt: Bảng Corporate — doanh nghiệp khách hàng phiếu ăn.
model MealCorporate {
  id                            String    @id @default(uuid()) @db.Uuid
  tenantCode                    String    @unique @db.VarChar(60) // 외부에 노출되는 테넌트 코드
  companyName                   String    @db.VarChar(200)
  taxCode                       String    @db.VarChar(50) // 베트남 세무 코드
  // 통합 인보이스의 buyer_address 매핑. 베트남 전자세금계산서는 주소 필수.
  addressFull                   String?   @db.VarChar(500)
  fundingModel                  String    @default("PREPAID_DEPOSIT") @db.VarChar(30) // PREPAID_DEPOSIT | CREDIT_NET15 | CREDIT_NET30
  monthlyBudgetVnd              BigInt    @default(0)
  depositBalanceVnd             BigInt    @default(0)
  creditLimitVnd                BigInt    @default(0)
  contactName                   String?   @db.VarChar(120)
  contactEmail                  String?   @db.VarChar(200)
  contactPhone                  String?   @db.VarChar(30)
  // 통합 인보이스 라인 그룹화 전략 (사양서 §4.3.4).
  //   BY_MERCHANT (기본) / BY_DAY / BY_DEPARTMENT / BY_CATEGORY / SINGLE_LINE
  einvoiceConsolidationStrategy String    @default("BY_MERCHANT") @db.VarChar(30)
  // 인보이스 발행 스케줄
  invoiceScheduleType    String    @default("MONTHLY") @db.VarChar(20) // MONTHLY | BIWEEKLY | WEEKLY | CUSTOM
  invoiceScheduleDay     Int?      // MONTHLY/CUSTOM: 1~28, BIWEEKLY: ignored, WEEKLY: ignored
  invoiceAutoGenerate    Boolean   @default(true)
  invoiceAutoSubmit      Boolean   @default(false)
  invoiceNotifyEmail     String?   @db.VarChar(200)
  // 크레딧 관리
  creditOutstandingVnd   BigInt    @default(0)
  lastPaymentAt          DateTime? @db.Timestamptz()
  overdueCount           Int       @default(0)
  status                        String    @default("ACTIVE") @db.VarChar(20)
  createdAt                     DateTime  @default(now()) @db.Timestamptz()
  updatedAt                     DateTime  @updatedAt @db.Timestamptz()
  deletedAt                     DateTime? @db.Timestamptz()

  departments         MealCorporateDepartment[]
  employees           MealEmployee[]
  policies            MealPolicy[]
  fundingAccounts     MealFundingAccount[]
  corporateAdminUsers CorporateAdminUser[]

  @@index([status], name: "idx_meal_corporate_status")
  @@index([invoiceScheduleType, invoiceScheduleDay], name: "idx_meal_corporate_invoice_schedule")
}

// 한국어: 기업 관리자(Corporate Admin) 테이블.
//   식권 고객 기업 소속 운영자 계정을 관리한다.
//   MealCorporate 와 1:N 관계를 가지며, 인증/권한은 중앙 auth 서버가 관리한다.
//
// Tiếng Việt: Bảng quản trị viên doanh nghiệp (Corporate Admin).
//   Quản lý tài khoản vận hành thuộc doanh nghiệp khách hàng phiếu ăn.
//   Có quan hệ 1:N với MealCorporate, còn xác thực/quyền do auth server trung tâm quản lý.
model CorporateAdminUser {
  id                String    @id @default(uuid()) @db.Uuid
  corporateId       String    @db.Uuid
  loginId           String    @db.VarChar(100)
  passwordHash      String    @db.VarChar(255)
  displayName       String    @db.VarChar(120)
  email             String?   @db.VarChar(200)
  phone             String?   @db.VarChar(30)
  status            String    @default("ACTIVE") @db.VarChar(20)
  lastLoginAt       DateTime? @db.Timestamptz()
  passwordChangedAt DateTime? @db.Timestamptz()
  createdAt         DateTime  @default(now()) @db.Timestamptz()
  updatedAt         DateTime  @updatedAt @db.Timestamptz()
  deletedAt         DateTime? @db.Timestamptz()

  // P0-2: Corporate 삭제 전 관리자 계정을 반드시 회수. 감사 추적.
  corporate MealCorporate @relation(fields: [corporateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([corporateId, loginId], name: "uq_corporate_admin_login")
  @@index([corporateId, status], name: "idx_corporate_admin_corporate")
}

// 한국어: 부서 테이블 — Corporate 산하.
// Tiếng Việt: Bảng phòng ban — thuộc Corporate.
model MealCorporateDepartment {
  id                 String    @id @default(uuid()) @db.Uuid
  corporateId        String    @db.Uuid
  departmentCode     String    @db.VarChar(60)
  departmentName     String    @db.VarChar(200)
  parentDepartmentId String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @db.Timestamptz()
  deletedAt          DateTime? @db.Timestamptz()

  corporate MealCorporate  @relation(fields: [corporateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  employees MealEmployee[]

  @@unique([corporateId, departmentCode], name: "uq_meal_dept_corp")
  @@index([corporateId], name: "idx_meal_dept_corp")
}

// 한국어: 임직원 테이블 — Corporate 산하 사용자.
//   사원증 RFID 매핑은 badgeRfid 필드.
// Tiếng Việt: Bảng nhân viên — người dùng thuộc Corporate.
model MealEmployee {
  id           String    @id @default(uuid()) @db.Uuid
  corporateId  String    @db.Uuid
  departmentId String?   @db.Uuid
  employeeCode String    @db.VarChar(60)
  fullName     String    @db.VarChar(200)
  email        String?   @db.VarChar(200)
  phone        String?   @db.VarChar(30)
  badgeRfid    String?   @db.VarChar(120)
  // 앱 디바이스 정보 + 알림 설정 (기획서 §9, §14)
  fcmToken                 String?  @db.VarChar(500)
  deviceId                 String?  @db.VarChar(200)
  platform                 String?  @db.VarChar(10) // IOS | ANDROID
  notificationSettingsJson Json?    // { orderStatus: true, payment: true, dailyLimit: true, promotion: false }
  languageCode             String   @default("vi") @db.VarChar(5)
  status       String    @default("ACTIVE") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @db.Timestamptz()
  deletedAt    DateTime? @db.Timestamptz()

  corporate  MealCorporate            @relation(fields: [corporateId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  // 부서 삭제 시 employee.departmentId 는 NULL 로 (직원 레코드는 유지).
  department MealCorporateDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  wallet     MealWallet?

  @@unique([corporateId, employeeCode], name: "uq_meal_emp_corp")
  @@index([corporateId, departmentId], name: "idx_meal_emp_corp_dept")
  @@index([badgeRfid], name: "idx_meal_emp_badge")
}

// 한국어: 임직원 식권 허용 계정(allowance ledger).
//   잔액은 VND BigInt 이며 companyAllowance / personalTopUp 버킷으로 분리된다.
// Tiếng Việt: Ví điện tử của nhân viên.
model MealWallet {
  id                  String   @id @default(uuid()) @db.Uuid
  corporateId         String   @db.Uuid
  employeeId          String   @unique @db.Uuid
  status              String   @default("ACTIVE") @db.VarChar(20) // ACTIVE | SUSPENDED | FROZEN | CLOSED
  balanceVnd          BigInt   @default(0)
  companyAllowanceVnd BigInt   @default(0)
  personalTopUpVnd    BigInt   @default(0)
  dailyLimitVnd       BigInt   @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @updatedAt @db.Timestamptz()

  // 직원 삭제 전 지갑 처리 필요 (잔액 회수). Restrict.
  employee       MealEmployee             @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  fundingEntries MealWalletFundingEntry[]

  @@index([corporateId, status], name: "idx_meal_wallet_corp_status")
  @@index([corporateId, createdAt(sort: Desc)], name: "idx_meal_wallet_corp_time")
}

// 한국어: Wallet Funding Entry — allowance ledger 원장.
//   회사 지원금/개인 충전/조정 이력을 기록한다.
// Tiếng Việt: Mục ghi sổ funding của wallet.
model MealWalletFundingEntry {
  id                String                      @id @default(uuid()) @db.Uuid
  walletId          String                      @db.Uuid
  sourceType        MealWalletFundingSourceType
  status            MealWalletFundingStatus     @default(POSTED)
  amountVnd         BigInt
  sourceBatchId     String?                     @db.VarChar(120)
  sourceReferenceId String?                     @db.VarChar(120)
  note              String?                     @db.VarChar(500)
  postedAt          DateTime?                   @db.Timestamptz()
  reversedAt        DateTime?                   @db.Timestamptz()
  createdAt         DateTime                    @default(now()) @db.Timestamptz()

  wallet MealWallet @relation(fields: [walletId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([walletId, sourceType], name: "idx_meal_wallet_entry_wallet_source")
  @@index([walletId, status, createdAt(sort: Desc)], name: "idx_meal_wallet_entry_wallet_status_time")
}

// 한국어: 식대 정책 (정책 빌더 산출물).
//   부서/직급/시간대/한도/Split Payment 규칙을 ruleJson 으로 저장.
// Tiếng Việt: Chính sách phiếu ăn.
model MealPolicy {
  id                     String    @id @default(uuid()) @db.Uuid
  corporateId            String    @db.Uuid
  policyCode             String    @db.VarChar(60)
  policyName             String    @db.VarChar(200)
  appliesToDepartmentIds String[]  @default([])
  appliesToRoleCodes     String[]  @default([])
  ruleJson               Json      @default("{}") // windows, allowedMerchantCategoryIds 등
  maxPerTransactionVnd   BigInt    @default(0)
  dailyLimitVnd          BigInt    @default(0)
  allowSplitPayment      Boolean   @default(true)
  status                 String    @default("ACTIVE") @db.VarChar(20)
  effectiveFrom          DateTime  @db.Date
  effectiveTo            DateTime? @db.Date
  createdAt              DateTime  @default(now()) @db.Timestamptz()
  updatedAt              DateTime  @updatedAt @db.Timestamptz()
  deletedAt              DateTime? @db.Timestamptz()

  corporate MealCorporate @relation(fields: [corporateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([corporateId, policyCode], name: "uq_meal_policy_corp")
  @@index([corporateId, status], name: "idx_meal_policy_corp")
}

// 한국어: Funding Account — Prepaid Deposit / Credit 모델 잔액 추적.
// Tiếng Việt: Tài khoản tài trợ.
model MealFundingAccount {
  id             String   @id @default(uuid()) @db.Uuid
  corporateId    String   @db.Uuid
  fundingModel   String   @db.VarChar(30) // PREPAID_DEPOSIT | CREDIT_NET15 | CREDIT_NET30
  bankCode       String?  @db.VarChar(50)
  bankAccountNo  String?  @db.VarChar(50)
  balanceVnd         BigInt   @default(0)
  creditLimitVnd     BigInt   @default(0)
  virtualAccountNo   String?  @db.VarChar(50) // 가상계좌 (Phase 2)
  virtualBankCode    String?  @db.VarChar(50)
  status             String   @default("ACTIVE") @db.VarChar(20)
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  // Corporate 삭제 전 Funding 잔액 정산 필요. Restrict.
  corporate MealCorporate @relation(fields: [corporateId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([corporateId], name: "idx_meal_funding_corp")
}

// 한국어: Merchant Enrollment — BrandHQ 가 식권 플랫폼에 참여한 레코드.
//   BrandHQ 엔티티에 1:1 attach. 1개 BrandHQ 는 활성 enrollment 1개만 가질 수 있다.
// Tiếng Việt: Bản ghi tham gia của nhà hàng đối tác (BrandHQ) vào nền tảng phiếu ăn.
model MealMerchantEnrollment {
  id             String    @id @default(uuid()) @db.Uuid
  brandHqId      String    @unique @db.Uuid // FK → BrandProfile.id (1:1)
  isActive       Boolean   @default(false)
  loopType       String    @default("OPEN_LOOP") @db.VarChar(20) // OPEN_LOOP | CLOSED_LOOP
  enrolledAt     DateTime  @default(now()) @db.Timestamptz()
  contractEndsAt DateTime? @db.Timestamptz()
  // 체크인/취소 설정 (기획서 §5.2.3, §5.2.5)
  tableCheckInMode       String @default("QR_CHECKIN") @db.VarChar(30) // QR_CHECKIN | POS_CONFIRM | NONE
  cancellationMode       String @default("FREE_UNTIL_ACCEPTED") @db.VarChar(30) // FREE_UNTIL_ACCEPTED | FREE_UNTIL_DEADLINE | NO_CANCEL
  cancellationDeadlineMin Int   @default(30)
  slotIntervalMin        Int   @default(30)
  slotCutoffMin          Int   @default(30)
  // 정산 인보이스 스케줄
  settlementInvoiceScheduleType String  @default("MONTHLY") @db.VarChar(20)
  settlementInvoiceScheduleDay  Int?
  createdAt      DateTime  @default(now()) @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @db.Timestamptz()

  commissionRates    MealMerchantCommissionRate[]
  settlementAccounts MealMerchantSettlementAccount[]

  @@index([isActive], name: "idx_meal_merchant_active")
}

// 한국어: Merchant 수수료율 (시기별 이력 관리).
// Tiếng Việt: Biểu phí merchant theo thời kỳ.
model MealMerchantCommissionRate {
  id                   String    @id @default(uuid()) @db.Uuid
  enrollmentId         String    @db.Uuid
  effectiveFrom        DateTime  @db.Date
  effectiveTo          DateTime? @db.Date
  baseRatePct          Decimal   @default(0) @db.Decimal(5, 2)
  specialZoneRatePct   Decimal?  @db.Decimal(5, 2)
  franchiseFlatRatePct Decimal?  @db.Decimal(5, 2)
  createdAt            DateTime  @default(now()) @db.Timestamptz()

  // Enrollment 삭제 전 수수료율 이력은 감사 목적으로 보존. Restrict.
  enrollment MealMerchantEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([enrollmentId, effectiveFrom(sort: Desc)], name: "idx_meal_commission_enrollment")
}

// 한국어: Merchant 정산 은행 계좌.
// Tiếng Việt: Tài khoản thanh toán của merchant.
model MealMerchantSettlementAccount {
  id                String   @id @default(uuid()) @db.Uuid
  enrollmentId      String   @db.Uuid
  bankCode          String   @db.VarChar(50)
  bankAccountNumber String   @db.VarChar(50)
  bankAccountHolder String   @db.VarChar(200)
  taxCode           String   @db.VarChar(50)
  isPrimary         Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz()
  updatedAt         DateTime @updatedAt @db.Timestamptz()

  // Enrollment 삭제 전 정산 계좌는 감사/송금 이력 때문에 Restrict.
  enrollment MealMerchantEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([enrollmentId, isPrimary], name: "idx_meal_settlacc_enrollment")
}

// ─────────────────────────────────────────────
// MealOrder Domain (주문 + 사전주문 + 일일메뉴 + 가맹점구독)
// 기획서 §5, §10, §19 기반 신규 모델
// ─────────────────────────────────────────────

// 한국어: 주문 — 앱 내 주문+결제 또는 사전주문의 단위.
// Tiếng Việt: Đơn hàng — đơn vị đặt hàng qua app.
model MealOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  walletId           String    @db.Uuid
  corporateId        String    @db.Uuid
  brandHqId          String    @db.Uuid
  branchId           String    @db.Uuid
  orderNo            String    @unique @db.VarChar(30)
  orderType          String    @default("ONSITE") @db.VarChar(20) // ONSITE | PRE_ORDER
  diningType         String    @db.VarChar(20) // DINE_IN | TAKEOUT
  status             String    @default("PAID_PENDING_ACCEPT") @db.VarChar(30)
  // PAID_PENDING_ACCEPT → ACCEPTED → PREPARING → READY → COMPLETED
  // 또는 → CANCELLED_BY_USER | REJECTED | EXPIRED
  totalAmountVnd     BigInt
  companyShareVnd    BigInt    @default(0)
  employeeShareVnd   BigInt    @default(0)
  scheduledAt        DateTime  @db.Timestamptz()
  tableNo            String?   @db.VarChar(20)
  checkedInAt        DateTime? @db.Timestamptz()
  reminderSentAt     DateTime? @db.Timestamptz()
  userLatitude       Float?
  userLongitude      Float?
  idempotencyKey     String    @db.VarChar(120)
  acceptedAt         DateTime? @db.Timestamptz()
  completedAt        DateTime? @db.Timestamptz()
  cancelledAt        DateTime? @db.Timestamptz()
  cancelReason       String?   @db.VarChar(200)
  expiresAt          DateTime? @db.Timestamptz()
  createdAt          DateTime  @default(now()) @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @db.Timestamptz()

  items MealOrderItem[]

  @@unique([idempotencyKey], name: "uq_meal_order_idempotency")
  @@index([walletId, status, createdAt(sort: Desc)], name: "idx_meal_order_wallet")
  @@index([branchId, status, createdAt(sort: Desc)], name: "idx_meal_order_branch")
  @@index([corporateId, createdAt(sort: Desc)], name: "idx_meal_order_corporate")
}

// 한국어: 주문 항목 — 메뉴 아이템 × 수량.
// Tiếng Việt: Mục trong đơn hàng.
model MealOrderItem {
  id           String @id @default(uuid()) @db.Uuid
  orderId      String @db.Uuid
  menuItemName String @db.VarChar(200)
  quantity     Int    @default(1)
  unitPriceVnd BigInt
  optionsJson  Json   @default("[]")
  createdAt    DateTime @default(now()) @db.Timestamptz()

  order MealOrder @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([orderId], name: "idx_meal_order_item_order")
}

// 한국어: 일일 메뉴 — 가맹점이 날짜+식사 유형별로 제공하는 메뉴판.
// Tiếng Việt: Thực đơn hàng ngày.
model MealDailyMenu {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @db.Uuid
  date      DateTime @db.Date
  mealType  String   @db.VarChar(20) // BREAKFAST | LUNCH | DINNER
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  items MealDailyMenuItem[]

  @@unique([branchId, date, mealType], name: "uq_meal_daily_menu_branch_date_meal")
  @@index([branchId, date], name: "idx_meal_daily_menu_branch_date")
}

// 한국어: 일일 메뉴 항목.
// Tiếng Việt: Mục thực đơn hàng ngày.
model MealDailyMenuItem {
  id          String  @id @default(uuid()) @db.Uuid
  dailyMenuId String  @db.Uuid
  name        String  @db.VarChar(200)
  priceVnd    BigInt
  imageUrl    String? @db.VarChar(500)
  calories    Int?
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz()

  dailyMenu MealDailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([dailyMenuId], name: "idx_meal_daily_menu_item")
}

// 한국어: 사전 주문 — 일일 메뉴 기반 미리 주문.
// Tiếng Việt: Đặt hàng trước — đặt trước dựa trên thực đơn hàng ngày.
model MealPreOrder {
  id           String    @id @default(uuid()) @db.Uuid
  walletId     String    @db.Uuid
  corporateId  String    @db.Uuid
  branchId     String    @db.Uuid
  dailyMenuId  String    @db.Uuid
  mealType     String    @db.VarChar(20)
  pickupSlot   String    @db.VarChar(20) // "12:00" 형식
  status       String    @default("PENDING") @db.VarChar(20) // PENDING | CONFIRMED | COMPLETED | CANCELLED
  totalAmountVnd     BigInt    @default(0)
  companyShareVnd    BigInt    @default(0)
  employeeShareVnd   BigInt    @default(0)
  idempotencyKey     String    @db.VarChar(120)
  createdAt    DateTime  @default(now()) @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @db.Timestamptz()

  items MealPreOrderItem[]

  @@unique([idempotencyKey], name: "uq_meal_preorder_idempotency")
  @@index([walletId, createdAt(sort: Desc)], name: "idx_meal_preorder_wallet")
}

// 한국어: 사전 주문 항목.
// Tiếng Việt: Mục đặt hàng trước.
model MealPreOrderItem {
  id              String @id @default(uuid()) @db.Uuid
  preOrderId      String @db.Uuid
  dailyMenuItemId String @db.Uuid
  quantity        Int    @default(1)
  createdAt       DateTime @default(now()) @db.Timestamptz()

  preOrder MealPreOrder @relation(fields: [preOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([preOrderId], name: "idx_meal_preorder_item")
}

// 한국어: 가맹점 구독 — 임직원이 특정 가맹점의 일일 메뉴를 구독.
// Tiếng Việt: Đăng ký thực đơn — nhân viên đăng ký nhận thực đơn hàng ngày của nhà hàng.
model MealMerchantSubscription {
  id              String   @id @default(uuid()) @db.Uuid
  employeeId      String   @db.Uuid
  branchId        String   @db.Uuid
  isActive        Boolean  @default(true)
  notifyBreakfast Boolean  @default(false)
  notifyLunch     Boolean  @default(true)
  notifyDinner    Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  @@unique([employeeId, branchId], name: "uq_meal_merchant_sub_emp_branch")
  @@index([employeeId, isActive], name: "idx_meal_merchant_sub_emp")
  @@index([branchId, isActive], name: "idx_meal_merchant_sub_branch")
}

// ─────────────────────────────────────────────
// 기존 모델 (수정 없음 — 필드 확장은 직접 편집)
// ─────────────────────────────────────────────

// 한국어: 결제 트랜잭션 (Open Loop QR / Closed Loop RFID/생체).
//   3-Way Matching 의 핵심 원장.
// Tiếng Việt: Giao dịch thanh toán.
model MealTransaction {
  id                 String    @id @default(uuid()) @db.Uuid
  walletId           String    @db.Uuid
  corporateId        String    @db.Uuid
  brandHqId          String    @db.Uuid
  branchId           String    @db.Uuid
  terminalId         String?   @db.Uuid
  loopType           String    @db.VarChar(20) // OPEN_LOOP | CLOSED_LOOP
  authMethod         String    @db.VarChar(30) // APP_QR | DYNAMIC_BARCODE | RFID_BADGE | BIOMETRIC_FACE | BIOMETRIC_FINGERPRINT
  requestedAmountVnd BigInt
  approvedAmountVnd  BigInt    @default(0)
  companyShareVnd    BigInt    @default(0)
  employeeShareVnd   BigInt    @default(0)
  status             String    @default("PENDING") @db.VarChar(20) // PENDING | APPROVED | DECLINED | REVERSED | SETTLED
  declineReason      String?   @db.VarChar(50)
  orderId            String?   @db.Uuid // 앱 주문 연동 시 MealOrder.id
  idempotencyKey     String    @db.VarChar(120)
  authorizedAt       DateTime? @db.Timestamptz()
  settledAt          DateTime? @db.Timestamptz()
  createdAt          DateTime  @default(now()) @db.Timestamptz()

  @@unique([idempotencyKey], name: "uq_meal_tx_idempotency")
  @@index([corporateId, status, createdAt(sort: Desc)], name: "idx_meal_tx_corp_status_time")
  @@index([brandHqId, status, createdAt(sort: Desc)], name: "idx_meal_tx_brand_status_time")
  @@index([walletId, createdAt(sort: Desc)], name: "idx_meal_tx_wallet_time")
  // P1-3: 4축 tenancy 조회 최적화. 정산·리포팅은 (corp, brand) 동시 필터가 빈번하다.
  @@index([corporateId, brandHqId, status, createdAt(sort: Desc)], name: "idx_meal_tx_tenancy")
  // P1-3: 지점별 거래 조회 (매장 대시보드용)
  @@index([branchId, status, createdAt(sort: Desc)], name: "idx_meal_tx_branch_status_time")
}

// 한국어: 정산 배치 (월말 또는 주간) — 3-Way Matching 결과 저장.
// Tiếng Việt: Batch đối soát.
model MealSettlementBatch {
  id                    String   @id @default(uuid()) @db.Uuid
  brandHqId             String   @db.Uuid
  periodStart           DateTime @db.Date
  periodEnd             DateTime @db.Date
  status                String   @default("OPEN") @db.VarChar(20) // OPEN | MATCHING | MATCHED | EXCEPTION | PAID
  grossAmountVnd        BigInt   @default(0)
  commissionAmountVnd   BigInt   @default(0)
  netPayableVnd         BigInt   @default(0)
  threeWayMismatchCount Int      @default(0)
  // 승인 워크플로우 (기획서 §8.2 확장)
  approvedBy            String?  @db.Uuid
  approvedAt            DateTime? @db.Timestamptz()
  approvalMemo          String?  @db.Text
  payoutReference       String?  @db.VarChar(120) // 은행 이체 참조번호
  payoutStatus          String?  @db.VarChar(30) // REQUESTED | COMPLETED | FAILED
  payoutRequestedAt     DateTime? @db.Timestamptz()
  payoutCompletedAt     DateTime? @db.Timestamptz()
  createdAt             DateTime @default(now()) @db.Timestamptz()
  updatedAt             DateTime @updatedAt @db.Timestamptz()

  @@unique([brandHqId, periodStart, periodEnd], name: "uq_meal_settlement_brand_period")
  @@index([brandHqId, status], name: "idx_meal_settlement_brand_status")
  @@index([status, approvedAt], name: "idx_meal_settlement_status_approved")
}

// 한국어: 플랫폼 사업자 법인 정보 — 통합 인보이스의 seller (발급자) 매핑.
//
//   베트남에서 우리가 e-Invoice 를 발급할 때 seller 로 표기되는 베트남 법인.
//   예) "Công ty Cổ phần Hyojung Softtech" (taxCode 0123456789).
//
//   본 식권 플랫폼은 베트남 전용이므로 country 분기는 두지 않는다. 한 시점에
//   isActive=true 인 row 가 정확히 1개여야 하며, 통합 인보이스 발급 시
//   `PlatformLegalEntityService.findActive()` 가 그 행을 반환한다. 법인 변경은
//   기존 row 의 isActive 를 false 로 두고 신규 row 를 ACTIVE 로 등록하는 형태로
//   영속화 (이력 추적용).
//
//   사양서: 1.Docs/식권관리플랫폼/EInvoice-WeTax-사양.md §4.4 Seller
//
// Tiếng Việt: Pháp nhân nền tảng tại Việt Nam — thông tin seller cho hoá đơn hợp nhất.
model PlatformLegalEntity {
  id                  String    @id @default(uuid()) @db.Uuid
  // 식별 코드 (예: 'HYOJUNG_VN_HQ'). 전역 unique.
  code                String    @unique @db.VarChar(60)
  // 베트남 사업자등록번호 (Mã số thuế). GDT 등록 번호.
  taxCode             String    @unique @db.VarChar(50)
  // 법적 명칭 — 베트남어 정자명.
  legalName           String    @db.VarChar(200)
  // 통합 인보이스 buyer 측에 보여지는 짧은 이름.
  displayName         String    @db.VarChar(200)
  // 베트남 현지 주소 (buyer_address 기재 용).
  addressFull         String    @db.VarChar(500)
  representativeName  String?   @db.VarChar(120)
  contactEmail        String?   @db.VarChar(200)
  contactEmailCc      String?   @db.VarChar(200)
  contactPhone        String?   @db.VarChar(30)
  // 통합 인보이스 발급 시 사용하는 default 시리얼 prefix ('C' 또는 'K').
  defaultSerialPrefix String    @default("C") @db.VarChar(2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now()) @db.Timestamptz()
  updatedAt           DateTime  @updatedAt @db.Timestamptz()
  deletedAt           DateTime? @db.Timestamptz()

  @@index([isActive], name: "idx_platform_legal_entity_active")
}
