// ─────────────────────────────────────────────
// RBAC (Role-Based Access Control) — P0
// 한국어: 기존 hardcoded RoleCode enum(8개) 을 DB 기반 RBAC 로 확장한다.
//   - Permission   : 미세 권한 어휘 (예: 'mealticket.policy.write')
//   - Role         : 역할. legacy RoleCode 8개를 seed 로 옮겨담는다.
//   - RolePermission : Role ↔ Permission N:N
//   - UserRoleAssignment : (SuperAdminUser | DistributorUser | BrandAdminUser | CorporateAdminUser) ↔ Role 다중 부여
//
//   기준서 §100.7 의 권한 계산식을 만족시키기 위한 우변 (User.roles.permissions) 을 제공한다.
//     실제 가용 권한 = BrandHq.activeCapabilities ∩ User.roles.permissions
//
//   기존 RolesGuard 의 역할 계층은 호환성을 위해 유지되며, RBAC 는 그 위에 덧붙는 형태다.
// Tiếng Việt: Mở rộng enum RoleCode hardcoded (8 vai trò) thành RBAC dựa trên DB.
// ─────────────────────────────────────────────

// 한국어: 권한 어휘 (단일 원본).
//   key 는 'domain.subdomain.action' 형태. 예) 'mealticket.policy.write', 'pos.menu.publish'.
//   isSystem=true 인 항목은 운영자가 임의 삭제 불가.
// Tiếng Việt: Bảng từ vựng quyền hạn.
model Permission {
  id            String   @id @default(uuid()) @db.Uuid
  permissionKey String   @unique @db.VarChar(120) // 'mealticket.policy.write'
  domain        String   @db.VarChar(40) // 'mealticket' / 'pos' / 'platform'
  // 한국어: 다국어 라벨. name = 베트남어 기본, nameKo / nameEn 은 선택.
  // Tiếng Việt: Nhãn đa ngôn ngữ. name là tiếng Việt mặc định.
  name           String?  @db.VarChar(200)
  nameKo         String?  @db.VarChar(200)
  nameEn         String?  @db.VarChar(200)
  description    String?  @db.VarChar(500)
  descriptionKo  String?  @db.VarChar(500)
  descriptionEn  String?  @db.VarChar(500)
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz()
  updatedAt     DateTime @updatedAt @db.Timestamptz()

  rolePermissions RolePermission[]

  @@index([domain], name: "idx_perm_domain")
}

// 한국어: 역할.
//   roleCode 는 legacy RoleCode enum 과 일치시킨다 (`PLATFORM_SUPER_ADMIN` 등).
//   scope 는 역할의 적용 범위. SuperAdmin 운영용 'PLATFORM' 또는 BrandHQ 직원용 'BRAND_HQ'.
//   isSystem=true 인 항목(8개 legacy 역할)은 삭제 불가.
//   향후 SuperAdmin 분권을 위해 sub-role (BILLING / OPS / SECURITY / READONLY) 을 isSystem=false 로 추가 가능.
// Tiếng Việt: Vai trò.
model Role {
  id             String   @id @default(uuid()) @db.Uuid
  roleCode       String   @unique @db.VarChar(80)
  // 한국어: 다국어 라벨. 물리 컬럼 name(vi 기본) 은 호환성을 위해 Prisma 필드 roleName 으로 노출. nameKo / nameEn 은 신규 선택 필드.
  // Tiếng Việt: Nhãn đa ngôn ngữ. Cột vật lý "name" được map sang trường Prisma "roleName" để giữ tương thích.
  roleName       String   @map("name") @db.VarChar(200)
  roleNameKo     String?  @map("nameKo") @db.VarChar(200)
  roleNameEn     String?  @map("nameEn") @db.VarChar(200)
  scope          String   @default("PLATFORM") @db.VarChar(30) // PLATFORM | DISTRIBUTOR | BRAND_HQ | BRANCH | CORPORATE
  isSystem       Boolean  @default(false)
  permissions       Json     @default("[]") // 권한 키 배열: ["dashboard:view", "distributors:*"]
  permissionVersion Int      @default(0)    // 클라이언트 캐시 무효화 트리거
  description    String?  @db.VarChar(500)
  descriptionKo  String?  @db.VarChar(500)
  descriptionEn  String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @db.Timestamptz()
  updatedAt      DateTime @updatedAt @db.Timestamptz()

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([scope], name: "idx_role_scope")
}

// 한국어: Role ↔ Permission N:N.
//   동일 (roleId, permissionId) 중복 방지.
// Tiếng Việt: Bảng nối Role ↔ Permission.
model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  grantedAt    DateTime @default(now()) @db.Timestamptz()
  grantedBy    String?  @db.Uuid // 부여한 SuperAdmin

  // P0-2: Role 또는 Permission 삭제 전 반드시 join row 를 정리해야 한다 (Restrict).
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([roleId, permissionId], name: "uq_role_permission")
  @@index([roleId], name: "idx_role_perm_role")
  @@index([permissionId], name: "idx_role_perm_perm")
}

// 한국어: 사용자 ↔ Role 다중 부여.
//   userType 으로 'SUPER_ADMIN' / 'DISTRIBUTOR_USER' / 'BRAND_ADMIN' / 'CORPORATE_ADMIN' 등 다중 사용자 모델을 통합 처리한다.
//   expiresAt 으로 임시/대리 권한 표현. revokedAt 으로 회수 추적.
//   동일 사용자에게 같은 role 이 동시에 ACTIVE 상태로 2개 이상이면 안 된다 (status 기반 partial unique).
// Tiếng Việt: Bảng gán nhiều role cho user.
model UserRoleAssignment {
  id                 String    @id @default(uuid()) @db.Uuid
  userType           String    @db.VarChar(30) // 'SUPER_ADMIN' | 'DISTRIBUTOR_USER' | 'BRAND_ADMIN' | 'CORPORATE_ADMIN'
  userId             String    @db.Uuid
  roleId             String    @db.Uuid
  status             String    @default("ACTIVE") @db.VarChar(20) // ACTIVE | EXPIRED | REVOKED
  // 한국어: 멀티테넌트 4축 스코프. distributor/brand/branch 는 BrandHQ 트리 축, corporate 는 CorporatePortal 축. 서로 다른 축 동시 설정 금지.
  // Tiếng Việt: 4 trục scope đa thuê bao. distributor/brand/branch thuộc cây BrandHQ, corporate là cây CorporatePortal. Không cho phép trộn trục.
  scopeDistributorId String?   @db.Uuid // 역할이 특정 RegionalDistributor 스코프일 때
  scopeBrandHqId     String?   @db.Uuid // 역할이 특정 BrandHQ 스코프일 때
  scopeBranchId      String?   @db.Uuid // 역할이 특정 Branch 스코프일 때
  scopeCorporateId   String?   @db.Uuid // 역할이 특정 Corporate 스코프일 때 (BrandHQ 축과 상호 배타)
  grantedAt          DateTime  @default(now()) @db.Timestamptz()
  grantedBy          String?   @db.Uuid // 부여한 SuperAdmin
  expiresAt          DateTime? @db.Timestamptz()
  revokedAt          DateTime? @db.Timestamptz()
  revokeReason       String?   @db.VarChar(500)

  // P0-2: Role 삭제 시 userRoleAssignment 는 먼저 정리되어야 한다 (Restrict).
  //   user 쪽은 FK 가 없으므로 애플리케이션 layer 에서 정리 책임.
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userType, userId, status], name: "idx_uraa_user_status")
  @@index([roleId, status], name: "idx_uraa_role_status")
  // P1-3: 사용자 × scope 축별 활성 assignment 조회 최적화.
  //   PermissionService.getEffectivePermissions() 가 자주 사용한다.
  @@index([userType, userId, status, scopeBrandHqId], name: "idx_uraa_brand_scope")
  @@index([userType, userId, status, scopeBranchId], name: "idx_uraa_branch_scope")
  @@index([userType, userId, status, scopeDistributorId], name: "idx_uraa_distributor_scope")
  @@index([userType, userId, status, scopeCorporateId], name: "idx_uraa_corporate_scope")
}
