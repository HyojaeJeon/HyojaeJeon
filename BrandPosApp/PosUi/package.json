{
  "name": "pos-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3002 -H 0.0.0.0",
    "parse-db": "npx tsx scripts/parse-db-master.ts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && bash ../../scripts/check-posui-rules.sh",
    "prepare": "cd ../.. && husky BrandPosApp/PosUi/.husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/postcss": "^4.2.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "next": "^16.2.1",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  }
}
